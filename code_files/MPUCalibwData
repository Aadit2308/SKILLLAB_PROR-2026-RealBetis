/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

/******************************************************************************
* MPU6050 Roll & Pitch using CORDIC (MicroBlaze - No math.h)
******************************************************************************/

/******************************************************************************
* MPU6050 Roll & Pitch using CORDIC + Calibration
* Outputs correction needed to return to stable (0,0)
* Example:
* Roll:10.00 Pitch:-20.00
* Correction -> Roll:-10.00 Pitch:20.00
******************************************************************************/

#include "xparameters.h"
#include "xiic.h"
#include "xil_printf.h"
#include "sleep.h"
#include <stdlib.h>

#define MPU6050_ADDR 0x68
#define PWR_MGMT_1   0x6B
#define ACCEL_CONFIG 0x1C
#define START_REG    0x3B

#define CORDIC_ITER 16

XIic Iic;

// Calibration offsets
int AX_OFFSET = 0;
int AY_OFFSET = 0;
int AZ_OFFSET = 0;

//--------------------------------------------------
// CORDIC LUT
//--------------------------------------------------
const int cordic_atan[16] = {
    4500, 2656, 1404, 713,
    358, 179, 90, 45,
    22, 11, 6, 3,
    1, 1, 0, 0
};

//--------------------------------------------------
// CORDIC atan2
//--------------------------------------------------
int cordic_atan2(int y, int x)
{
    int angle = 0;
    int x_new, y_new;

    for(int i = 0; i < CORDIC_ITER; i++)
    {
        if(y > 0)
        {
            x_new = x + (y >> i);
            y_new = y - (x >> i);
            angle += cordic_atan[i];
        }
        else
        {
            x_new = x - (y >> i);
            y_new = y + (x >> i);
            angle -= cordic_atan[i];
        }

        x = x_new;
        y = y_new;
    }

    return angle;
}

//--------------------------------------------------
// CORDIC magnitude
//--------------------------------------------------
int cordic_mag(int x, int y)
{
    int x_new, y_new;

    for(int i = 0; i < CORDIC_ITER; i++)
    {
        if(y > 0)
        {
            x_new = x + (y >> i);
            y_new = y - (x >> i);
        }
        else
        {
            x_new = x - (y >> i);
            y_new = y + (x >> i);
        }

        x = x_new;
        y = y_new;
    }

    return x;
}

//--------------------------------------------------
// MPU6050 Calibration
//--------------------------------------------------
void calibrate_mpu6050()
{
    long ax_sum = 0;
    long ay_sum = 0;
    long az_sum = 0;

    u8 recv_buf[14];
    u8 reg;

    xil_printf("\r\n====================================\r\n");
    xil_printf("Keep sensor FLAT and STILL...\r\n");
    xil_printf("Calibration started...\r\n");
    xil_printf("====================================\r\n");

    for(int i = 0; i < 500; i++)
    {
        reg = START_REG;

        XIic_Send(Iic.BaseAddress, MPU6050_ADDR, &reg, 1, XIIC_STOP);
        XIic_Recv(Iic.BaseAddress, MPU6050_ADDR, recv_buf, 14, XIIC_STOP);

        int ax = (short)((recv_buf[0] << 8) | recv_buf[1]);
        int ay = (short)((recv_buf[2] << 8) | recv_buf[3]);
        int az = (short)((recv_buf[4] << 8) | recv_buf[5]);

        ax_sum += ax;
        ay_sum += ay;
        az_sum += az;

        usleep(5000);
    }

    AX_OFFSET = ax_sum / 500;
    AY_OFFSET = ay_sum / 500;
    AZ_OFFSET = (az_sum / 500) - 16384;

    xil_printf("Calibration Complete!\r\n");
    xil_printf("AX_OFFSET = %d\r\n", AX_OFFSET);
    xil_printf("AY_OFFSET = %d\r\n", AY_OFFSET);
    xil_printf("AZ_OFFSET = %d\r\n", AZ_OFFSET);
    xil_printf("====================================\r\n\r\n");
}

//--------------------------------------------------
// MAIN
//--------------------------------------------------
int main()
{
    XIic_Config *Config;
    int status;

    u8 recv_buf[14];
    u8 reg;
    u8 data[2];

    xil_printf("====================================\r\n");
    xil_printf("MPU6050 CORDIC Stabilization System\r\n");
    xil_printf("====================================\r\n");

    //--------------------------------------------------
    // I2C Initialization
    //--------------------------------------------------
    Config = XIic_LookupConfig(0);
    if(Config == NULL)
    {
        xil_printf("I2C Config Failed\r\n");
        return 0;
    }

    status = XIic_CfgInitialize(&Iic, Config, Config->BaseAddress);
    if(status != XST_SUCCESS)
    {
        xil_printf("I2C Init Failed\r\n");
        return 0;
    }

    XIic_Start(&Iic);

    //--------------------------------------------------
    // Wake MPU6050
    //--------------------------------------------------
    data[0] = PWR_MGMT_1;
    data[1] = 0x00;
    XIic_Send(Iic.BaseAddress, MPU6050_ADDR, data, 2, XIIC_STOP);

    usleep(10000);

    //--------------------------------------------------
    // Set accelerometer ±2g
    //--------------------------------------------------
    data[0] = ACCEL_CONFIG;
    data[1] = 0x00;
    XIic_Send(Iic.BaseAddress, MPU6050_ADDR, data, 2, XIIC_STOP);

    usleep(10000);

    //--------------------------------------------------
    // Sensor Calibration
    //--------------------------------------------------
    calibrate_mpu6050();

    //--------------------------------------------------
    // Main Loop
    //--------------------------------------------------
    while(1)
    {
        reg = START_REG;

        XIic_Send(Iic.BaseAddress, MPU6050_ADDR, &reg, 1, XIIC_STOP);
        status = XIic_Recv(Iic.BaseAddress, MPU6050_ADDR, recv_buf, 14, XIIC_STOP);

        if(status != 14)
        {
            xil_printf("Read Error\r\n");
            continue;
        }

        //----------------------------------------------
        // Raw Data
        //----------------------------------------------
        int ax = (short)((recv_buf[0] << 8) | recv_buf[1]);
        int ay = (short)((recv_buf[2] << 8) | recv_buf[3]);
        int az = (short)((recv_buf[4] << 8) | recv_buf[5]);

        //----------------------------------------------
        // Apply Calibration
        //----------------------------------------------
        ax -= AX_OFFSET;
        ay -= AY_OFFSET;
        az -= AZ_OFFSET;

        //----------------------------------------------
        // Roll
        //----------------------------------------------
        int roll = cordic_atan2(ay, az);

        //----------------------------------------------
        // Pitch
        //----------------------------------------------
        int mag = cordic_mag(ay, az);
        int pitch = cordic_atan2(-ax, mag);

        //----------------------------------------------
        // Required correction to reach stable 0,0
        //----------------------------------------------
        int roll_correction = -roll;
        int pitch_correction = -pitch;

        //----------------------------------------------
        // Output
        //----------------------------------------------
        xil_printf("AX:%d AY:%d AZ:%d | ", ax, ay, az);

        xil_printf("Roll:%d.%02d Pitch:%d.%02d | ",
                   roll/100, abs(roll%100),
                   pitch/100, abs(pitch%100));

        xil_printf("Correction -> Roll:%d.%02d Pitch:%d.%02d\r\n",
                   roll_correction/100, abs(roll_correction%100),
                   pitch_correction/100, abs(pitch_correction%100));

        usleep(200000);
    }

    return 0;
}
